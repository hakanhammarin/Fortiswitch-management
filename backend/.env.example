# Copy to .env and fill in real values. Never commit the real .env file.

# Required: 32-byte hex key used to encrypt switch SSH passwords at rest.
# Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=

# HTTP port for the API server.
PORT=4000

# How often (ms) to poll every switch for port/PoE/VLAN/MAC state.
POLL_INTERVAL_MS=30000

# Where to keep the git-versioned config backup repository.
# BACKUP_REPO_DIR=./data/config-backups

# Read-only 10mila_monitoring inventory import. Point this at a local
# checkout of https://github.com/hakanhammarin/10mila_monitoring (read-only
# access only - this app never writes to that repo).
# MONITORING_REPO_PATH=/path/to/10mila_monitoring
# MONITORING_CIS_FILE=/path/to/10mila_monitoring/cis_10mila.json
# MONITORING_SWITCH_NAME_REGEX=^SW\d+

# Dev-only mock switch fleet credentials (src/ssh/mockSwitchServer.js, src/seedDev.js).
# MOCK_SWITCH_USER=admin
# MOCK_SWITCH_PASSWORD=admin123
